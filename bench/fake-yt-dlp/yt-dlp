#!/bin/bash
# Fake yt-dlp shim. Two modes keyed by MOCK_DELAY_MS:
#
#  MOCK_DELAY_MS=0  (LAN / shim mode):
#      Returns instantly. Measures purely the wrapping MCP server's overhead,
#      with NO yt-dlp cost — best case for yt-dlp-based servers.
#
#  MOCK_DELAY_MS>0  (PROD-sim mode):
#      Simulates real yt-dlp: sleeps (3 × delay) ms for the network round-trips
#      yt-dlp performs internally, plus the measured ~240 ms Python+yt-dlp
#      cold-start tax that every invocation pays.

DELAY_MS="${MOCK_DELAY_MS:-0}"

case "$*" in
  *--version*)
    if [ "$DELAY_MS" -gt 0 ]; then sleep 0.24; fi
    echo "2026.03.17"
    exit 0
    ;;
  *--dump-json*)
    if [ "$DELAY_MS" -gt 0 ]; then
      python3 -c "import time; time.sleep(0.24 + 3 * $DELAY_MS / 1000.0)"
    fi
    cat <<'JSON'
{"id":"dQw4w9WgXcQ","title":"Sample","duration":1800,"channel":"Sample","upload_date":"20240101","subtitles":{"en":[{"ext":"vtt"}]},"automatic_captions":{"en":[{"ext":"vtt"}]}}
JSON
    exit 0
    ;;
esac

# Locate the --output template if present and derive a target dir.
out_dir=""
for ((i=1; i<=$#; i++)); do
  arg="${!i}"
  if [[ "$arg" == "--output" || "$arg" == "-o" ]]; then
    next=$((i+1))
    template="${!next}"
    out_dir="$(dirname "$template")"
  fi
done

if [ "$DELAY_MS" -gt 0 ]; then
  python3 -c "import time; time.sleep(0.24 + 3 * $DELAY_MS / 1000.0)"
fi

if [ -n "$out_dir" ] && [ -d "$out_dir" ]; then
  cp /tmp/bench/canned/canned.en.vtt "$out_dir/Sample.en.vtt"
  echo "[info] Writing video subtitles to: $out_dir/Sample.en.vtt" >&2
else
  cp /tmp/bench/canned/canned.en.vtt ./video.en.vtt
  echo "[info] Writing video subtitles to: ./video.en.vtt" >&2
fi
exit 0
